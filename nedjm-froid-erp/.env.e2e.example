# Credentials for Playwright E2E (@critical contrats / users / RLS).
# Copy to .env.e2e (gitignored) — never commit real passwords.

# Primary account (SUPER_ADMIN recommended) — used for contrats + provision
E2E_EMAIL=abdeslam@nedjm-froid.com
E2E_PASSWORD=replace-with-stable-password


do $$
declare
  t text;
begin
  foreach t in array array[
    'sys_roles','sys_screens','sys_users','ref_activity_codes','ref_sites',
    'ref_global_vars','ref_legendes','hr_employees','hr_contracts',
    'com_client_contracts','com_draft_adjustments'
